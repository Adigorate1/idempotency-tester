{
  "manifest_version": 3,
  "name": "Transaction Traffic Robot",
  "version": "1.0",
  "description": "Automatically captures transaction requests (exact time, request, response) on any page. Click the robot icon to view and copy the JSON.",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["relay.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Transaction Traffic Robot"
  }
}
